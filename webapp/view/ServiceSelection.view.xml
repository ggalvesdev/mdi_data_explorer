<mvc:View
	controllerName="com.sap.mdi.explorer.controller.ServiceSelection"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc">

	<Page
		id="serviceSelectionPage"
		title="{= ${i18n>serviceSelTitle} + ' – ' + ${serviceData>/currentSubaccountName} }"
		showNavButton="true"
		navButtonPress=".onNavBack"
		busy="{appView>/busy}">

		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="{i18n>cancelButton}" press=".onNavBack" type="Reject" icon="sap-icon://log" />
			</Toolbar>
		</footer>

		<subHeader>
			<Toolbar>
				<SearchField
					id="instanceSearch"
					placeholder="{i18n>searchPlaceholder}"
					liveChange=".onSearchInstances"
					width="100%" />
			</Toolbar>
		</subHeader>

		<List
			id="instanceList"
			items="{serviceData>/filteredInstances}"
			mode="SingleSelectMaster"
			selectionChange=".onInstanceSelect"
			noDataText="{i18n>noInstances}"
			growing="true"
			growingThreshold="50">
			<ObjectListItem
				title="{serviceData>name}"
				intro="{serviceData>orgName} · {serviceData>spaceName}"
				icon="sap-icon://it-instance"
				type="Navigation">
				<attributes>
					<ObjectAttribute text="{serviceData>last_operation/state}" />
					<ObjectAttribute text="GUID: {serviceData>guid}" />
				</attributes>
			</ObjectListItem>
		</List>

	</Page>

</mvc:View>
